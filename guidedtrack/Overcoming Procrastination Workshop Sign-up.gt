--------------------------------------------------------------------------------
-- NAME: Overcoming Procrastination Workshop Sign-up
-- Registration page for the live workshop "Overcoming Procrastination" (Clearer
-- Thinking with Spencer Greenberg, Nov 24, 2026). Built from the sign-up version of
-- "Career Change Workshop Sign-up" (git e338df3). Collects an email, asks whether the
-- registrant wants an accountability partner, sends a confirmation email, and records
-- where the sign-up came from.
--
-- HOW TO USE
-- 1. Settings block below. When the Zoom link exists, set joinLinkKnown = 1 and fill
--    workshopJoinLink, workshopMeetingId and workshopPasscode (also add the Zoom URL to
--    calendarLink's details/location, written with + for spaces, unencoded).
-- 2. In GuidedTrack: Settings -> Branding, set "Email display name" to "Clearer Thinking"
--    and the Reply-To address, so the email does not arrive from the program name.
-- 3. Share the run link with ?src=newsletter, ?src=social, etc. src is saved per sign-up.
-- 4. Accountability pairs: filter the data export on accountabilityOptIn = 1. The column
--    projectToWorkOn helps match people with similar projects.
-- 5. Unlike the career workshop, there is NO live Google Sheet sync: the /api/workshop-signup
--    endpoint writes to the career workshop's sheet. The GT data export has every field.
-- 6. Embedded at programs.clearerthinking.org/procrastination-workshop-with-spencer-greenberg/
--    (team repo willfind/clearer-thinking-programs-static, src/data/programs/<that slug>/).
--    Spencer's photo and the .ics file are served from that folder's static/; when the Zoom
--    details are known, update the .ics there too.
-- 7. Header drawing: owl-header.svg in that same static/ folder (GuidedTrack strips <img> AND data: URLs
--    in CSS, so every image must be a hosted file referenced by a literal url()).
--
-- GUIDEDTRACK GOTCHAS BAKED IN HERE (verified 2026-09-14 with a scratch program)
-- - 0 and "" are TRUTHY in *if; only an undefined variable is falsy. Every flag
--   below is therefore tested with "= 1", never as a bare *if: flag.
-- - text.find returns the 1-based position of the FIRST match, or nothing (falsy).
-- - An *if condition must test a variable, not a method call. Assign first, then test.
-- - A text line that starts with *Word:* is parsed as a keyword, so bold leads
--   are done in HTML (<b>) or with multi-word phrases only.
-- - <img> is stripped from *html, so the logo is a CSS background image.
-- - *html styles are cleared on every page change, so each page carries its own.
--------------------------------------------------------------------------------

-- SETTINGS (edit these) ---------------------------------------------------------
>> workshopTitle = "Overcoming Procrastination"
>> workshopSubtitle = "Research-backed techniques to get going on personal and professional projects"
>> workshopDate = "Tuesday, November 24"
>> workshopTime = "12:30 to 1:30 pm Eastern Time (9:30 am Pacific, 5:30 pm UK)"
>> joinLinkKnown = 0
>> workshopJoinLink = ""
>> workshopMeetingId = ""
>> workshopPasscode = ""
-- Google Calendar link: 17:30 to 18:30 UTC (EST is UTC-5 in late November). Use + for spaces.
>> calendarLink = "https://calendar.google.com/calendar/render?action=TEMPLATE&text=Overcoming+Procrastination+(Clearer+Thinking+workshop)&dates=20261124T173000Z/20261124T183000Z&details=Free+live+online+workshop+from+Clearer+Thinking+with+Spencer+Greenberg.+We'll+email+the+Zoom+link+before+the+session."
>> facilitatorName = "Spencer Greenberg"
>> facilitatorLine = "Founder of Clearer Thinking, Positly, GuidedTrack and PersonalityMap"
>> icsLink = "https://programs.clearerthinking.org/procrastination-workshop-with-spencer-greenberg/overcoming-procrastination.ics"
-- Link shown to registrants for sharing.
>> signupUrl = "https://programs.clearerthinking.org/procrastination-workshop-with-spencer-greenberg"
---------------------------------------------------------------------------------

-- Tracking parameter from the run URL (?src=newsletter). Empty when absent.
*if: not src
	>> src = ""

-- Must be set BEFORE the jump below, or the confirmation page shows an empty "When:" for
-- people who used the "Sign up now" shortcut (the career workshop template had this bug).
>> whenText = "{workshopDate}, {workshopTime}"

-- "Sign up now" at the top reloads the page with &jump=form (GuidedTrack strips inline
-- JavaScript from *html); the run then skips the invitation and opens the form.
*if: not jump
	>> jump = ""
*if: jump = "form"
	*goto: signupForm

*settings
	*menu: no
	*back: yes

--------------------------------------------------------------------------------
-- PAGE 1: the invitation
--------------------------------------------------------------------------------
