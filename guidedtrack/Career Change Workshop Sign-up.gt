			.program_container .ct-facts { border: 1px solid #dfe6f0 !important; border-radius: 10px !important; box-shadow: none !important; background: #f4f8fd !important; padding: 16px 20px !important; margin: 0 0 24px 0 !important; }
			.program_container .ct-facts p { margin: 3px 0; font-size: 16px; }
			.program_container .ct-facts b { color: #1a1a1a; }
			.program_container ul.ct-list { padding-left: 22px; margin: 0 0 8px 0; }
			.program_container ul.ct-list li { font-size: 17px; line-height: 1.6; color: #2a2a2a; margin-bottom: 10px; }
			.program_container ul.ct-list li b { color: #1a1a1a; }
			@media (max-width: 480px) { .program_container h1.ct-title { font-size: 28px !important; } .program_container p.ct-sub { font-size: 18px; } }
			
			.program_container p.ct-sub { font-size: 17px; line-height: 1.5; margin: 0 0 8px 0; }
			.program_container .prompt { font-size: 17px; font-weight: 600; color: #1a1a1a; }
			.program_container .tip { color: #6b7380; font-size: 15px; line-height: 1.45; }
			.program_container .form-control { border-radius: 8px; border: 1px solid #cfd6e0; padding: 12px 14px; height: auto; font-size: 17px; box-shadow: none; }
			.program_container .form-control:focus { border-color: #0885F8; box-shadow: 0 0 0 3px rgba(8,133,248,0.22); outline: none; }
			.program_container li.answer { border: 1px solid #dfe6f0; border-radius: 8px; margin-bottom: 8px; }
			.program_container li.answer:hover, .program_container li.answer:focus-within { border-color: #0885F8; }
			.program_container .ct-warn { border: 1px solid #f3c98b !important; border-radius: 10px !important; box-shadow: none !important; background: #fff7ea !important; padding: 12px 16px !important; margin: 0 0 18px 0 !important; }
			.program_container .ct-warn p { margin: 0; font-size: 16px; color: #6b4a12; }
		</style>

	*if: emailLooksWrong = 1
		*component
			*classes: ct-warn
			*html
				<p>That email address doesn't look complete (it needs an @ and a dot after it). Please check it and try again.</p>

	*html
		<div class="ct-brandrow"><span class="ct-logo"></span><span class="ct-wordmark">Clearer Thinking</span></div>
		<h1 class="ct-title">Where should we send the link to join?</h1>

	*question: Email address
		*tip: Used only for emails about this workshop: the confirmation, the link to join, and the recording if we send one. Nothing else.
		*type: text
		*placeholder: you@example.com
		*save: signupEmail

	*question: First name (optional)
		*tip: So the emails can say hello properly.
		*type: text
		*blank
		*placeholder: Your first name
		*save: signupFirstName

	*question: Is there one question you'd like the session to answer? (optional)
		*tip: A sentence is plenty. We pass these to Angel before the session.
		*type: paragraph
		*blank
		*placeholder: e.g., How do I compare two paths when both seem possible?
		*save: questionForSession

-- Light check that the address can receive mail: an @ that isn't first, and a dot after it.
-- text.find returns the 1-based position, or nothing (falsy) when the text is absent.
>> signupEmail = signupEmail.clean
>> emailLooksWrong = 0
>> atPosition = signupEmail.find("@")
*if: not atPosition
	>> emailLooksWrong = 1
*if: atPosition
	*if: atPosition < 2
		>> emailLooksWrong = 1
	>> dotPosition = signupEmail.find(".")
	*if: not dotPosition
		>> emailLooksWrong = 1
	*if: dotPosition
		*if: dotPosition < atPosition + 2
			>> emailLooksWrong = 1
*if: emailLooksWrong = 1
	*goto: signupForm

>> signedUpAt = calendar::now

--------------------------------------------------------------------------------
-- CONFIRMATION EMAIL
--------------------------------------------------------------------------------
>> greetingName = ""
>> headingName = ""
>> hasFirstName = 0
*if: signupFirstName
	*if: signupFirstName.size > 0
		>> hasFirstName = 1
*if: hasFirstName = 1
	>> greetingName = " {signupFirstName}"
	>> headingName = ", {signupFirstName}"

>> emailWhenLine = "We're fixing the date now and will email you as soon as it's set."
*if: dateKnown = 1
	>> emailWhenLine = "{workshopDate}, {workshopTime}."

>> emailLinkLine = "We'll email you the link to join 24 hours before the event starts, and add you to the event's Google Calendar invite."
*if: joinLinkKnown = 1
	>> emailLinkLine = "Join here: {workshopJoinLink}"

*email
	*to: {signupEmail}
	*subject: You're registered: {workshopTitle}
	*body
		Hi{greetingName},

		You're registered for *{workshopTitle}: {workshopSubtitle}*, a free live workshop from Clearer Thinking with {facilitatorName} of Overcome.

		*Date and time:* {emailWhenLine}

		*Where to join:* Online. {emailLinkLine}

		*What to expect:* what the research says about finding a career that fits, what predicts a career change going well, and how to work through the obstacles readers told us about (too many options, the cost of the transition, age and credentials, and a job market unsettled by AI).

		*About the recording:* the session will be recorded and we'll send the recording to everyone who registered. We still recommend attending live, so you can ask questions and interact with other participants in the chat.

		*Add it to your calendar:* [Google Calendar|{calendarLink}], or download the [.ics file|{icsLink}] for Apple Calendar, Outlook and others.

		Nothing else to do for now. If you have a question for the session, or you can't come after all, reply to this email and say so.

		Igor Scaldini
		Clearer Thinking

