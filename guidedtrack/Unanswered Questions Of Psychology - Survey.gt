-- From Spencer's spreadsheet: https://docs.google.com/spreadsheets/d/1cIreVxInZh9a6rWq2Qc-HRzp5UE1oL1ZUiQVD1ZsUec/edit?gid=0#gid=0
>> example_question1 = "Is mental health best modeled by categories or factors, and what is the right set of categories or factors to carve the reality of mental health differences at the joints?"
>> example_question2 = "What are the deep, underlying, modifiable psychological causes of why some people have higher long-term subjective well-being than others?"
>> example_question3 = "What scalable psychological interventions can reduce polarization and between-group animosity without suppressing legitimate disagreement?"

-- From here: https://doi.org/10.1007/s11427-025-3024-y (p.20)
>> example_question4 = "What (if any) neuroimaging biomarkers can be validated to accurately guide individualized treatment selection for depression?"

>> example_question5 = "What is the right model for how human beliefs change in the face of evidence (including deviations from Bayesian rationality)?"

>> example_question6 = "What is the right model for how interoceptive signals are integrated with exteroception (externally detected signals) to determine emotion?"

-- From here: https://journals.sagepub.com/doi/pdf/10.1177/1088868318811759 (p.354-5)
>> example_question7 = "How do members of a group come to share the same moral values?"


-- Added during round of edits with Spencer and Igor, on 07-16-26. To be placed third in the list of examples.
>> example_question8 = "What are the true psychological impacts of social media, and how do these differ by demographic group and by social media app type?"


